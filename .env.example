# Copy this file to .env for local testing. Do not commit .env.
TANAKEN_URL=https://www.tanaken-1982.co.jp/ja/ir.html
INUNEKO_URL=https://corp.inuneko-seikatsu.co.jp/ir/
# The Inuneko XJ Storage API URL has a safe default in the program.
# INUNEKO_API_URL=https://www.xj-storage.jp/public-list/GetList2.aspx?...
STATE_FILE=state/seen.txt

# Gmail example: use an app password, not your regular account password.
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM=your-account@gmail.com
ALERT_TO=recipient@example.com

# Optional. Leave these unset to generate a company-specific subject.
# GitHub Actions can set them as repository variables instead.
# ALERT_SUBJECT='New IR announcement'
# TEST_SUBJECT='Latest IR announcement'
